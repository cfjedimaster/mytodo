{
  "name": "My To Do",
  "short_name": "My To Do",
  "description": "Calm, focused daily task lists and reminders that stay synced everywhere.",
  "start_url": "/app",
  "scope": "/",
  "display": "standalone",
  "background_color": "#f3eaff",
  "theme_color": "#f3eaff",
  "icons": [
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/favicon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ]
}

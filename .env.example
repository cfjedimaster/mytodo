# Server-side environment variables for Netlify Functions (never prefix with VITE_)
# Set these in Netlify (Site configuration -> Environment variables) and in local .env for `netlify dev`.
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
# Generate with: openssl rand -hex 32
SESSION_SECRET=replace-with-at-least-32-random-characters
ADMIN_PASSWORD=replace-with-your-admin-password
